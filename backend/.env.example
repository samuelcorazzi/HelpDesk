# Servidor
PORT=3001
FRONTEND_URL=http://localhost:3002

# Autenticação
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"
JWT_EXPIRES_IN="8h"

# Usado apenas pelo comando npm.cmd run admin:create
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ADMIN_EMAIL="admin@helpdesk.local"
INITIAL_ADMIN_PASSWORD="troque-por-uma-senha-forte"

# PostgreSQL do Supabase
# Use o transaction pooler (porta 6543) na aplicação.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"

# Use o session pooler (porta 5432) nas migrations.
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"
